# Postgres connection string used by the app at runtime. If your provider
# gives you a pooled connection string (Neon, Vercel Postgres, Supabase
# with pgbouncer, etc.), use that here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freedom_sports"

# Used only by `prisma migrate deploy`/`migrate dev` (schema migrations
# need a direct, non-pooled connection). If you only have one connection
# string, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/freedom_sports"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Must match your deployed URL exactly in production, e.g.
# https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Local-disk fallback for uploads (dev only). In production, attach a
# Vercel Blob store to the project and Vercel sets BLOB_READ_WRITE_TOKEN
# automatically — when that's present, uploads go to Blob storage instead
# of local disk (which doesn't persist on serverless hosts). See README.
UPLOADS_DIR="./storage/uploads"
# BLOB_READ_WRITE_TOKEN=
